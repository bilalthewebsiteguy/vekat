# Copy to .env.local for development, and set the same variables in the host's environment
# (Vercel: Project → Settings → Environment Variables). Never commit the real values.

# The shared MongoDB database. The HomeBridge site uses the SAME connection string, so one person
# registering on both sites has one record and one reference.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=homebridge

# Stripe, for the registration fee: the secret key of the account that owns the Payment Link
# (STRIPE_PAYMENT_LINK in src/lib/payment-methods.ts). A live link needs the live key (sk_live_…).
STRIPE_SECRET_KEY=

# Given by Stripe when you create the webhook endpoint (or by `stripe listen` locally).
# Only needed for fees paid later by a registration's reference; form payments do not use it.
STRIPE_WEBHOOK_SECRET=

# Email, for the confirmation the member gets after submitting the registration form.
# Sent over SMTP from the vekat.org mailbox at GoDaddy. Without SMTP_USER and SMTP_PASSWORD no
# confirmation email is sent (registrations still save normally).

# The full mailbox address and its password, exactly as you sign in to webmail with.
SMTP_USER=info@vekat.org
SMTP_PASSWORD=

# GoDaddy "Professional Email" uses these and they are the defaults, so you can leave them empty.
# A GoDaddy mailbox on Microsoft 365 instead needs SMTP_HOST=smtp.office365.com and SMTP_PORT=587.
SMTP_HOST=
SMTP_PORT=

# Optional. Must be the same mailbox as SMTP_USER or GoDaddy refuses the message.
EMAIL_FROM=Home Bridge <info@vekat.org>

# Optional: where replies go, and a blind copy of every confirmation for the office record.
EMAIL_REPLY_TO=
EMAIL_BCC=
