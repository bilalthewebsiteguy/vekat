# Copy to .env.local for development, and set the same variables in the host's environment
# (Vercel: Project → Settings → Environment Variables). Never commit the real values.

# The shared MongoDB database. The HomeBridge site uses the SAME connection string, so one person
# registering on both sites has one record and one reference.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=homebridge

# Stripe, for the registration fee: the secret key of the account that owns the Payment Link
# (STRIPE_PAYMENT_LINK in src/lib/payment-methods.ts). A live link needs the live key (sk_live_…).
STRIPE_SECRET_KEY=

# Given by Stripe when you create the webhook endpoint (or by `stripe listen` locally).
# Only needed for fees paid later by a registration's reference; form payments do not use it.
STRIPE_WEBHOOK_SECRET=
